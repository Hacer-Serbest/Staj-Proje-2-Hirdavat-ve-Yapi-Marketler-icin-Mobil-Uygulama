# Django
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Expo Go / fiziksel telefondan test ederken makinenizin LAN IP'sini de ekleyin, örn:
# ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50

# Veritabanı — boş bırakılırsa SQLite (BASE_DIR/db.sqlite3) kullanılır.
# Prod (Render) ortamında Render otomatik olarak DATABASE_URL sağlar.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# CORS — frontend origin(leri), virgülle ayrılmış
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MIN=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Prod (config.settings.production) ayarları
SECURE_SSL_REDIRECT=True

DJANGO_LOG_LEVEL=INFO
